# INTERNHUB Backend Environment Configuration
# DATABASE_URL = database connection (PostgreSQL URL; optional - falls back to local embedded PGlite if unset)
DATABASE_URL=

# JWT_SECRET = authentication secret (Token signing key for role-based sessions)
JWT_SECRET=

# INTERN_API_KEY = optional external internship API credential (Optional; system operates fully using local database if unset)
INTERN_API_KEY=

# EXTERNAL_SYNC_ENABLED = automatic external internship synchronization (Default: false)
EXTERNAL_SYNC_ENABLED=false

# EXTERNAL_SYNC_INTERVAL_MINUTES = interval between automatic synchronizations in minutes (Default: 360)
EXTERNAL_SYNC_INTERVAL_MINUTES=360

# PORT = server listener port (Default: 3000)
PORT=3000
