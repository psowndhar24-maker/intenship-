# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# INTERNHUB Core System Configuration
# DATABASE_URL = database connection (PostgreSQL URL; optional - falls back to local embedded PGlite if unset)
DATABASE_URL=
# JWT_SECRET = authentication secret (Token signing key for role-based sessions)
JWT_SECRET=
# INTERN_API_KEY = optional external internship API credential (Optional; system operates fully using local database if unset)
INTERN_API_KEY=
# EXTERNAL_SYNC_ENABLED = automatic external internship synchronization (Default: false)
EXTERNAL_SYNC_ENABLED=false
# EXTERNAL_SYNC_INTERVAL_MINUTES = interval between automatic synchronizations in minutes (Default: 360)
EXTERNAL_SYNC_INTERVAL_MINUTES=360
# PORT = server listener port (Default: 3000)
PORT=3000

# FRONTEND_URL = Allowed frontend origin(s) for production CORS (e.g., https://internhub.vercel.app or comma-separated origins)
FRONTEND_URL=

# Frontend Environment Configuration
# VITE_API_URL = Production API base URL for the frontend (leave empty or /api for same-origin, or set to your deployed backend URL e.g. https://api.yourdomain.com)
VITE_API_URL=

